# ReverseBug Environment Configuration Template
# For development, defaults are provided in docker-compose.yml
# NEVER commit real secrets or production database URLs.

# Environment: development | staging | production
RB_ENV=development
RB_HTTP_ADDR=:8080
RB_PUBLIC_BASE_URL=http://localhost:5173
RB_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Database & Cache
RB_DATABASE_URL=postgres://reversebug:reversebug_dev_password@localhost:5433/reversebug?sslmode=disable
RB_REDIS_URL=redis://localhost:6379/0

# Object Storage (S3-compatible MinIO in dev)
RB_S3_ENDPOINT=http://localhost:9000
RB_S3_ACCESS_KEY=minioadmin
RB_S3_SECRET_KEY=minioadminpassword
RB_S3_BUCKET_QUARANTINE=rb-quarantine
RB_S3_BUCKET_ARTIFACTS=rb-artifacts
RB_S3_BUCKET_REPORTS=rb-reports
RB_S3_USE_SSL=false

# Security & Secrets (Must be 32 bytes base64 encoded)
# Generate with: openssl rand -base64 32
RB_DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
RB_API_KEY_PEPPER=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
RB_COOKIE_SECURE=false
RB_ADMIN_REQUIRE_MFA=false
RB_TRUST_PROXY_HEADERS=false

# Mail (Mailpit in development)
RB_SMTP_HOST=localhost
RB_SMTP_PORT=1025
RB_SMTP_USER=
RB_SMTP_PASSWORD=
RB_SMTP_FROM="ReverseBug <no-reply@reversebug.local>"

# AI Providers (Configurable per task, never committed)
RB_AI_PROVIDER=mock
RB_AI_MOCK_ENABLED=true
# RB_OPENAI_API_KEY=
# RB_ANTHROPIC_API_KEY=
# RB_GEMINI_API_KEY=
